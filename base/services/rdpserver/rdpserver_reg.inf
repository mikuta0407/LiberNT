; LiberNT RDP console server: a service that serves the console session from boot.
; It listens while fDenyTSConnections under Control\Terminal Server is 0.

[AddReg]
HKLM,"SYSTEM\CurrentControlSet\Services\LiberNTRDPServer","DisplayName",0x00000000,"LiberNT RDP Console Server"
HKLM,"SYSTEM\CurrentControlSet\Services\LiberNTRDPServer","Description",0x00000000,"Lets users connect to the console session, including the logon screen, with Remote Desktop."
HKLM,"SYSTEM\CurrentControlSet\Services\LiberNTRDPServer","ErrorControl",0x00010001,0x00000001
HKLM,"SYSTEM\CurrentControlSet\Services\LiberNTRDPServer","ImagePath",0x00020000,"%SystemRoot%\system32\rdpserver\rdpserver.exe /service %SystemRoot%\system32\rdpserver\rdpserver.ini"
HKLM,"SYSTEM\CurrentControlSet\Services\LiberNTRDPServer","ObjectName",0x00000000,"LocalSystem"
HKLM,"SYSTEM\CurrentControlSet\Services\LiberNTRDPServer","Start",0x00010001,0x00000002
HKLM,"SYSTEM\CurrentControlSet\Services\LiberNTRDPServer","Type",0x00010001,0x00000010
